<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Amazon.Lambda.TestUtilities" Version="4.3.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SampleService\SampleService.csproj" />
        <ProjectReference Include="..\SampleService.UiBackend\SampleService.UiBackend.csproj" />
        <ProjectReference Include="..\SampleService.ScheduledWorker\SampleService.ScheduledWorker.csproj" />
        <ProjectReference Include="..\SampleService.PublicApi\SampleService.PublicApi.csproj" />
        <ProjectReference Include="..\SampleService.Local\SampleService.Local.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\SampleService.PublicApi\openapi.yaml" Link="openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
