<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Featurewise as a package, or from a local checkout when FeaturewiseSource is set; see Directory.Build.props. -->
        <PackageReference Include="Featurewise.Core" Version="$(FeaturewiseVersion)" Condition="'$(FeaturewiseSource)' == ''" />
        <ProjectReference Include="$(FeaturewiseDirectory)Featurewise/Featurewise.csproj" Condition="'$(FeaturewiseSource)' != ''" />
    </ItemGroup>

</Project>
