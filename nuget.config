<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Featurewise's packages, Featurewise.Core and Featurewise.Hosting, come from the owner's GitHub Packages feed, everything else from nuget.org.
       Restoring needs GITHUB_PACKAGES_TOKEN set to a token that can read packages: in CI, the workflow's
       token; locally, export GITHUB_PACKAGES_TOKEN=$(gh auth token), after gh auth refresh -s read:packages. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="featurewise" value="https://nuget.pkg.github.com/ada74m/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="featurewise">
      <package pattern="Featurewise.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <featurewise>
      <add key="Username" value="ada74m" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </featurewise>
  </packageSourceCredentials>

</configuration>
